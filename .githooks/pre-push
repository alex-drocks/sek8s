#!/bin/bash
set -euo pipefail

# Pre-push hook: blocks pushing any branch that contains sensitive security
# files to the public repo. Uses a tree-level check (not diff-level), so
# sensitive files are caught regardless of how they entered the branch.
#
# Fails closed: if the paths file is missing or unreadable when pushing to
# the public repo, the push is blocked rather than silently allowed.

REMOTE_NAME="$1"
REMOTE_URL="$2"

PUBLIC_REPO_PATTERN="chutesai/sek8s([.]git)?$"

if ! [[ "$REMOTE_URL" =~ $PUBLIC_REPO_PATTERN ]]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
SENSITIVE_PATHS_FILE="$REPO_ROOT/.security-sensitive-paths"

if [[ ! -f "$SENSITIVE_PATHS_FILE" ]]; then
    echo ""
    echo "=========================================================="
    echo "  PUSH BLOCKED: cannot verify branch safety"
    echo "=========================================================="
    echo ""
    echo "  Remote: $REMOTE_NAME ($REMOTE_URL)"
    echo ""
    echo "  The file .security-sensitive-paths is missing."
    echo "  This hook cannot verify the branch is free of sensitive"
    echo "  files without it. Restore the file or run:"
    echo ""
    echo "    make install-hooks"
    echo ""
    echo "  from a clean checkout of main."
    echo ""
    echo "=========================================================="
    echo ""
    exit 1
fi

mapfile -t SENSITIVE_PATHS < <(grep -v '^\s*$' "$SENSITIVE_PATHS_FILE" | grep -v '^\s*#')

if [[ ${#SENSITIVE_PATHS[@]} -eq 0 ]]; then
    echo ""
    echo "=========================================================="
    echo "  PUSH BLOCKED: cannot verify branch safety"
    echo "=========================================================="
    echo ""
    echo "  Remote: $REMOTE_NAME ($REMOTE_URL)"
    echo ""
    echo "  .security-sensitive-paths exists but contains no patterns."
    echo "  This hook cannot verify the branch is free of sensitive"
    echo "  files without at least one path pattern defined."
    echo ""
    echo "=========================================================="
    echo ""
    exit 1
fi

BLOCKED=0

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    if [[ "$LOCAL_SHA" == "0000000000000000000000000000000000000000" ]]; then
        continue
    fi

    for pattern in "${SENSITIVE_PATHS[@]}"; do
        pattern="$(echo "$pattern" | sed 's:/*$::')"

        if git ls-tree -r --name-only "$LOCAL_SHA" | grep -q "^${pattern}"; then
            if [[ $BLOCKED -eq 0 ]]; then
                echo ""
                echo "=========================================================="
                echo "  PUSH BLOCKED: sensitive security files detected"
                echo "=========================================================="
                echo ""
                echo "  Remote: $REMOTE_NAME ($REMOTE_URL)"
                echo "  Ref:    $LOCAL_REF"
                echo ""
                echo "  Matched paths:"
            fi
            BLOCKED=1
            echo "    - $pattern"
            break
        fi
    done
done

if [[ $BLOCKED -ne 0 ]]; then
    echo ""
    echo "  This branch contains files that must not reach the public repo."
    echo "  Push audit branches to the 'security' remote instead."
    echo ""
    echo "=========================================================="
    echo ""
    exit 1
fi

exit 0
